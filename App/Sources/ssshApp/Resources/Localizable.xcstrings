{
  "sourceLanguage": "nl",
  "strings": {
    "%@ (%@)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)"
          }
        }
      },
      "comment": "Appends a technical reason to a tunnel failure"
    },
    "%@ De server zegt: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ The server says: %@"
          }
        }
      },
      "comment": "Appends the server's own explanation to a failure message"
    },
    "%@ begreep sssh niet: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sssh could not read %@: %@"
          }
        }
      },
      "comment": "Names a setting whose value could not be read"
    },
    "%@ bestaat al.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already exists."
          }
        }
      },
      "comment": "Says which path already exists"
    },
    "%@ bestaat niet (meer).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not exist (any more)."
