{
  "sourceLanguage": "nl",
  "strings": {
    "%@ De server zegt: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ The server says: %@"
          }
        }
      },
      "comment": "Appends the server's own explanation to a failure message"
    },
    "%@ bestaat al.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already exists."
          }
        }
      },
      "comment": "Says which path already exists"
    },
    "%@ bestaat niet (meer).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not exist (any more)."
          }
        }
      },
      "comment": "An SFTP operation named a path the server does not have"
    },
    "%@ is beveiligd met een wachtwoordzin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is protected by a passphrase."
          }
        }
      },
      "comment": "An encrypted key was supplied without its passphrase"
    },
    "%@ kon niet worden gelezen als sleutelbestand.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not be read as a key file."
          }
        }
      },
      "comment": "The key file could not be parsed at all"
    },
    "%@, afgerond, afsluitcode onbekend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, finished, exit status unknown"
          }
        }
      },
      "comment": "Accessibility label for a finished block with no reported exit status"
    },
    "%@, gelukt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, succeeded"
          }
        }
      },
      "comment": "Accessibility label for a successful command block"
    },
    "%@, loopt nog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, still running"
          }
        }
      },
      "comment": "Accessibility label for a running command block"
    },
    "%@, mislukt met code %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, failed with status %lld"
          }
        }
      },
      "comment": "Accessibility label for a failed command block, with its exit status"
    },
    "%@/s": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/s"
          }
        }
      },
      "comment": "A transfer rate, as bytes per second"
    },
    "%lld bezig": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld in progress"
          }
        }
      },
      "comment": "How many transfers are still running or waiting"
    },
    "%lld geselecteerd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld selected"
          }
        }
      },
      "comment": "How many files are selected"
    },
    "%lld procent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld percent"
          }
        }
      },
      "comment": "Accessibility value: the divider position as a percentage"
    },
    "%lld vensters": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld panes"
          }
        }
      },
      "comment": "Accessibility label for the pane count on a tab"
    },
    "(geen opdracht)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(no command)"
          }
        }
      },
      "comment": "Placeholder for a block whose command could not be recovered"
    },
    "Aangeboden sleutel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presented key"
          }
        }
      },
      "comment": "Label for the host key the server presented"
    },
    "Aanmaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create"
          }
        }
      },
      "comment": "Button that creates a new folder"
    },
    "Aanmelden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticating"
          }
        }
      },
      "comment": "Section header: authentication"
    },
    "Aanmelden is mislukt. Geprobeerd: %@. De server accepteert: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed. Tried: %@. The server accepts: %@."
          }
        }
      },
      "comment": "Authentication failed; lists what was tried and what the server accepts"
    },
    "Aanmelden met": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with"
          }
        }
      },
      "comment": "Field label: how to authenticate"
    },
    "Adres": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address"
          }
        }
      },
      "comment": "Field label: hostname or IP address"
    },
    "Afgerond wissen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear finished"
          }
        }
      },
      "comment": "Button that clears finished transfers from the queue"
    },
    "Alles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All"
          }
        }
      },
      "comment": "Block filter: show every command"
    },
    "Alles annuleren": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel all"
          }
        }
      },
      "comment": "Button that cancels every queued transfer"
    },
    "Anderen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Others"
          }
        }
      },
      "comment": "Permission class: everyone else"
    },
    "Annuleer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
      },
      "comment": "Button: cancel the credential prompt"
    },
    "Beide bewaren": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep both"
          }
        }
      },
      "comment": "Collision option: keep both files by renaming the new one"
    },
    "Bestand %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File %@"
          }
        }
      },
      "comment": "Accessibility label for a file row without a known size"
    },
    "Bestand %@, %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File %@, %@"
          }
        }
      },
      "comment": "Accessibility label for a file row, with its size"
    },
    "Bestanden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files"
          }
        }
      },
      "comment": "Title of the file browser"
    },
    "Bestandsoverdracht komt in een volgende versie.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File transfer is coming in a later version."
          }
        }
      },
      "comment": "SFTP is not implemented yet"
    },
    "Betere blokken met shell-integratie": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Better blocks with shell integration"
          }
        }
      },
      "comment": "Button offering to show the shell integration snippet"
    },
    "Bewaar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        }
      },
      "comment": "Button: save the host"
    },
    "Bewaren in de sleutelhanger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to the keychain"
          }
        }
      },
      "comment": "Checkbox: store this secret in the Keychain"
    },
    "Bewaren is mislukt: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving failed: %@"
          }
        }
      },
      "comment": "Shown when saving the host record failed"
    },
    "Bewerken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        }
      },
      "comment": "Context menu: edit this host's settings"
    },
    "Bezig": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        }
      },
      "comment": "A transfer that is running"
    },
    "De extra verificatie is afgebroken.": {
      "comment": "A keyboard-interactive challenge was cancelled or could not be answered",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The additional verification was cancelled."
          }
        }
      }
    },
    "De hostsleutel van %@ is geweigerd. Er is geen verbinding gemaakt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host key for %@ was refused. No connection was made."
          }
        }
      },
      "comment": "Shown after the user refuses a host key, or after a mismatch"
    },
    "De hostsleutel van %@ is veranderd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host key for %@ has changed"
          }
        }
      },
      "comment": "Title of the sheet shown when a host key does not match the stored one"
    },
    "De server kon de bewerking niet uitvoeren.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not carry out the operation."
          }
        }
      },
      "comment": "The server refused an SFTP operation without saying why"
    },
    "De server kon de bewerking op %@ niet uitvoeren.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not carry out the operation on %@."
          }
        }
      },
      "comment": "The server refused an SFTP operation without saying why, naming the path"
    },
    "De server ondersteunt deze bewerking niet: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server does not support this operation: %@."
          }
        }
      },
      "comment": "The server does not implement the requested SFTP operation"
    },
    "De server sprak het SFTP-protocol niet correct: %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not speak the SFTP protocol correctly: %@."
          }
        }
      },
      "comment": "The server sent something the SFTP protocol does not allow"
    },
    "De server spreekt SFTP-versie %lld; sssh heeft minstens versie 3 nodig.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server speaks SFTP version %lld; sssh needs at least version 3."
          }
        }
      },
      "comment": "The server offered an SFTP protocol version this client cannot speak"
    },
    "De server vraagt om aanvullende gegevens.": {
      "comment": "Fallback when a keyboard-interactive challenge carries no instruction",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is asking for more information."
          }
        }
      }
    },
    "De server weigerde een verzoek: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused a request: %@"
          }
        }
      },
      "comment": "A channel request was refused; placeholder is a technical detail"
    },
    "De shell is gestopt door signaal %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shell was stopped by signal %@."
          }
        }
      },
      "comment": "Shown when the remote shell was killed by a signal"
    },
    "De shell is gestopt met afsluitcode %lld.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shell exited with status %lld."
          }
        }
      },
      "comment": "Shown when the remote shell exited with a non-zero status"
    },
    "De sleutel %@ is beveiligd met een wachtwoordzin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key %@ is protected by a passphrase."
          }
        }
      },
      "comment": "Says which key file needs a passphrase"
    },
    "De vensters en deelvensters van tmux worden tabbladen en splitsingen in sssh, en je werk blijft draaien als de verbinding wegvalt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "tmux windows and panes become tabs and splits in sssh, and your work keeps running when the connection drops."
          }
        }
      },
      "comment": "Footer explaining what tmux control mode buys the user"
    },
    "De verbinding is door de server verbroken.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server closed the connection."
          }
        }
      },
      "comment": "The remote end closed the connection"
    },
    "De verbinding is verbroken.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection was closed."
          }
        }
      },
      "comment": "The user disconnected"
    },
    "De verbinding is weggevallen tijdens de overdracht.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped during the transfer."
          }
        }
      },
      "comment": "The SSH connection dropped during a transfer"
    },
    "De verbinding reageert niet meer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection has stopped responding."
          }
        }
      },
      "comment": "Keep-alive probes went unanswered"
    },
    "De wachtwoordzin voor %@ klopt niet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passphrase for %@ is not correct."
          }
        }
      },
      "comment": "The passphrase for a private key was wrong"
    },
    "Deel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share"
          }
        }
      },
      "comment": "Menu item that shares a block as text"
    },
    "Deze server gebruikt alleen verouderde versleuteling die sssh niet ondersteunt. Werk de server bij, of gebruik OpenSSH.": {
      "comment": "The server only offers pre-2014 key exchange or ciphers",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server only offers outdated encryption that sssh does not support. Update the server, or use OpenSSH."
          }
        }
      }
    },
    "Dit apparaat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device"
          }
        }
      },
      "comment": "Title of the local side of the file browser"
    },
    "Dit kan betekenen dat de server opnieuw is geïnstalleerd. Het kan ook betekenen dat iemand het verkeer onderschept. Verbind alleen als u weet welke van de twee het is.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can mean the server was reinstalled. It can also mean someone is intercepting the traffic. Only connect if you know which it is."
          }
        }
      },
      "comment": "Explains the two reasons a host key changes and advises caution"
    },
    "Dit kan niet ongedaan worden gemaakt: op een server is er geen prullenbak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone: a server has no trash."
          }
        }
      },
      "comment": "Warning that remote deletion is permanent"
    },
    "Dit sleuteltype wordt nog niet ondersteund.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key type is not supported yet."
          }
        }
      },
      "comment": "A private key file type is not supported"
    },
    "Download": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        }
      },
      "comment": "Button that downloads the selected remote files"
    },
    "Een naam mag geen schuine streep bevatten en kan niet . of .. zijn.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name cannot contain a slash, and cannot be . or .."
          }
        }
      },
      "comment": "Explains why a proposed filename is not allowed"
    },
    "Eenmalig verbinden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect once"
          }
        }
      },
      "comment": "Button: accept the host key for this connection only"
    },
    "Eerder vertrouwd": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previously trusted"
          }
        }
      },
      "comment": "Label for a host key that was trusted before"
    },
    "Eerste verbinding met %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First connection to %@"
          }
        }
      },
      "comment": "Title of the sheet shown on a first connection to a host"
    },
    "Eigenaar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Owner"
          }
        }
      },
      "comment": "Permission class: the file's owner"
    },
    "Elke keer vragen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask every time"
          }
        }
      },
      "comment": "Authentication method: prompt on every connection"
    },
    "Er bestaat al iets met deze naam": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something with this name already exists"
          }
        }
      },
      "comment": "Title of the file collision prompt"
    },
    "Er is al iets bewaard voor deze host. Laat het veld leeg om dat te houden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something is already saved for this host. Leave the field empty to keep it."
          }
        }
      },
      "comment": "Shown when a secret already exists, explaining that leaving the field blank keeps it"
    },
    "Er is geen verbinding.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no connection."
          }
        }
      },
      "comment": "An operation was attempted with no connection"
    },
    "Er is iets misgegaan: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong: %@"
          }
        }
      },
      "comment": "Fallback when a failure has no better description"
    },
    "Er wordt niets bewaard. sssh vraagt bij elke verbinding om een wachtwoord.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is saved. sssh asks for a password on every connection."
          }
        }
      },
      "comment": "Explains that nothing is stored for this authentication method"
    },
    "Extra verificatie nodig": {
      "comment": "Title of a keyboard-interactive prompt when the server gave no name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional verification needed"
          }
        }
      }
    },
    "Filter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter"
          }
        }
