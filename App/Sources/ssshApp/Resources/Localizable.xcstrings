    "Bewaren is mislukt: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving failed: %@"
          }
        }
      },
      "comment": "Shown when saving the host record failed"
