    "Deze host heeft nog geen tunnels.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This host has no tunnels yet."
          }
        }
      },
      "comment": "Empty state in the tunnel panel"
    },
    "Deze naam wordt op de server opgezocht, niet hier. Daarom werkt een adres dat alleen daar bestaat.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name is resolved on the server, not here, which is why an address that only exists there works."
          }
        }
      },
      "comment": "Explains that the destination is resolved on the server"
    },
    "Deze server gebruikt alleen verouderde versleuteling die sssh niet ondersteunt. Werk de server bij, of gebruik OpenSSH.": {
      "comment": "The server only offers pre-2014 key exchange or ciphers",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server only offers outdated encryption that sssh does not support. Update the server, or use OpenSSH."
          }
        }
      }
    },
    "Deze tunnel is nog niet compleet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tunnel is not complete yet."
          }
        }
      },
      "comment": "Shown on a saved tunnel that is missing a host or port"
    },
    "Direct uitvoeren": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run immediately"
          }
        }
      },
      "comment": "Toggle: send a newline after the snippet"
