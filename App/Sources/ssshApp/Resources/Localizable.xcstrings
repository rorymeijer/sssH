    "sssh kent deze server nog niet. Controleer de vingerafdruk voordat u verbindt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sssh does not know this server yet. Check the fingerprint before connecting."
          }
        }
      },
      "comment": "Asks the user to verify the fingerprint on a first connection"
    },
    "sssh ondersteunt ssh-agent nog niet.": {
      "extractionState": "manual",
      "localizations": {
