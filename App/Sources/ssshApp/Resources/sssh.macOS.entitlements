<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Outgoing connections: the whole point of the app. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Reading ~/.ssh/config and known_hosts on import (Phase 6) happens
	     through an open panel, so the app needs no blanket file access. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- CloudKit's private database, for hosts, groups, snippets, tunnels and
	     host-key fingerprints. Nothing secret goes here: private keys,
	     passphrases and passwords live in the Keychain and the synced model
	     holds only an opaque reference to them. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.nl.rorymeijer.sssh</string>
	</array>

	<!-- The Keychain group the secrets store writes to. Secrets are wrapped
	     with a Secure Enclave key before they go in; iCloud Keychain sync is
	     opt-in and off by default. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)nl.rorymeijer.sssh</string>
	</array>

	<!-- Deliberately absent: network.server, device.camera, device.microphone,
	     personal-information.*, and automation. An SSH client needs none of
	     them, and leaving them out is what makes that checkable. -->
</dict>
</plist>
